generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Member {
  id            Int                @id @default(autoincrement())
  cpf           String             @unique
  firstName     String
  lastName      String
  parcaId       Int?
  parca         Member?            @relation("Parca", fields: [parcaId], references: [id], onDelete: Restrict)
  parcaDe       Member[]           @relation("Parca")
  ministerios   Ministry[]
  celulas       Cell[]
  ministryLinks MinistryMember[]
  cellLinks     CellMember[]
  enrollments   CourseEnrollment[]
  lessonsTaught Lesson[]
  attendances   LessonAttendance[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model Ministry {
  id        Int              @id @default(autoincrement())
  name      String           @unique
  leaderId  Int
  leader    Member           @relation(fields: [leaderId], references: [id], onDelete: Restrict)
  members   MinistryMember[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model Cell {
  id        Int          @id @default(autoincrement())
  name      String       @unique
  leaderId  Int
  leader    Member       @relation(fields: [leaderId], references: [id], onDelete: Restrict)
  members   CellMember[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model MinistryMember {
  id         Int      @id @default(autoincrement())
  ministryId Int
  ministry   Ministry @relation(fields: [ministryId], references: [id], onDelete: Cascade)
  memberId   Int
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role       Int      @default(3)

  @@unique([ministryId, memberId])
}

model CellMember {
  id       Int    @id @default(autoincrement())
  cellId   Int
  cell     Cell   @relation(fields: [cellId], references: [id], onDelete: Cascade)
  memberId Int
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role     Int    @default(3)

  @@unique([cellId, memberId])
}

model Course {
  id          Int                @id @default(autoincrement())
  name        String             @unique
  enrollments CourseEnrollment[]
  lessons     Lesson[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model CourseEnrollment {
  id       Int    @id @default(autoincrement())
  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  memberId Int
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([courseId, memberId])
}

model Lesson {
  id          Int                @id @default(autoincrement())
  name        String
  courseId    Int
  course      Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacherId   Int
  teacher     Member             @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  date        DateTime
  attendances LessonAttendance[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([courseId])
  @@index([teacherId])
  @@index([date, id])
}

model LessonAttendance {
  lessonId Int
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  memberId Int
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([lessonId, memberId])
  @@index([memberId])
}
